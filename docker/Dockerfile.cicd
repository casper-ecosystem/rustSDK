ARG TARGETPLATFORM=linux/amd64
FROM --platform=${TARGETPLATFORM} node:22.13-alpine AS build

ENV NODE_ENV=development
ARG BUILD_CONFIGURATION=docker
ENV BUILD_CONFIGURATION=$BUILD_CONFIGURATION

WORKDIR /app

# Update npm to the latest version
RUN npm install -g npm@latest

COPY ./examples/frontend/angular .
COPY pkg pkg

RUN rm -rf node_modules package-lock.json
# Until pkg is npm copy files and change path to root
RUN sed -i 's|\"casper-rust-wasm-sdk\": \"file:\(\.\.\/\)\+pkg\"|\"casper-rust-wasm-sdk\": \"file:pkg\"|' package.json
RUN sed -i 's/"input": "\(\.\.\/\)\+pkg"/\"input": "pkg"/g' project.json

RUN npm install --ignore-scripts --verbose && npm update

RUN npm run build -- --configuration=$BUILD_CONFIGURATION --verbose

ARG TARGETPLATFORM=linux/amd64
FROM --platform=${TARGETPLATFORM} node:22.13-alpine

ENV PORT=8080

WORKDIR /app

# Install serve globally (better SPA support with automatic fallback)
RUN npm install -g serve

COPY --from=build --chown=node:node /app/dist/casper ./dist/

EXPOSE 8080

# Use serve with SPA mode which automatically serves index.html for all routes
CMD ["serve", "-s", "/app/dist", "-l", "8080"]