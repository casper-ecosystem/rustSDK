{
  "name": "casper-webclient",
  "version": "2.0.0",
  "description": "Casper Client Demo app",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --linux",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^34.0.1",
    "electron-builder": "^26.0.0",
    "electron-updater": "^6.4.0"
  },
  "build": {
    "appId": "com.example.myapp",
    "productName": "Casper Webclient",
    "compression": "store",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": "favicon.png"
    },
    "linux": {
      "category": "Network",
      "icon": "favicon.png"
    },
    "mac": {
      "category": "Network",
      "icon": "favicon.png"
    },
    "files": [
      "index.js",
      "favicon.png"
    ],
    "extraFiles": [
      {
        "from": "./../../frontend/angular/dist/casper",
        "to": "frontend/angular/dist/casper"
      },
      {
        "from": "./../../frontend/angular/ws-proxy.js",
        "to": "resources/ws-proxy.js"
      }
    ],
    "extraResources": [
      {
        "from": "node_modules/ws",
        "to": "node_modules/ws",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}