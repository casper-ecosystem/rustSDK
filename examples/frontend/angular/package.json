    "casper-rust-wasm-sdk": "file:../../../pkg",
    "highlight.js": "^11.11.1",
    "promise-worker": "^2.0.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~22.1.7",
